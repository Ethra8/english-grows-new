#: .\home\templates\home\privacy_policy.html:556
msgid "6. International data transfers"
msgstr "6. Transferències internacionals de dades"

#: .\home\templates\home\privacy_policy.html:559
msgid ""
"\n"
"                    Our service providers may process personal data\n"
"                    outside the European Economic Area (EEA),\n"
